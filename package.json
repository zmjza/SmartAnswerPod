{
  "name": "kaida-auto-quiz",
  "version": "2.3.1",
  "private": true,
  "description": "开大智达舱",
  "author": "kaida",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "package": "node scripts/package-local.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "preview": "vite preview",
    "test:p0": "node --experimental-strip-types --test tests/p0.test.mts",
    "test:t002-post-scan": "node tests/t002-post-scan.mjs",
    "test:e2e:bank": "node --experimental-strip-types tests/e2e-bank.mjs",
    "test:e2e:bank-import": "node --experimental-strip-types tests/e2e-bank-import.mjs",
    "test:e2e:chg026-ui": "node --experimental-strip-types tests/e2e-chg026-ui.mjs",
    "test:e2e:settings": "node --experimental-strip-types tests/e2e-settings.mjs",
    "test:e2e:run-lock": "node --experimental-strip-types tests/e2e-run-lock.mjs",
    "test:e2e:workbench": "node --experimental-strip-types tests/e2e-workbench.mjs",
    "postinstall": "playwright install chromium && patchright install chromium"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "patchright": "^1.63.0",
    "playwright": "^1.55.0",
    "vue": "^3.5.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.28.8",
    "vue-tsc": "^2.2.0"
  }
}
